# Docker Compose Environment Variables
# Copy this file to .env.docker and update with secure values for your environment
# Usage: docker-compose --env-file .env.docker up -d

# Redis
REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# PostgreSQL
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
POSTGRES_USER=prabogo
POSTGRES_DB=prabogo

# RabbitMQ
RABBITMQ_USER=prabogo
RABBITMQ_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Grafana LGTM (docker-compose.grafana.yml) - Loki + Grafana + Tempo + Mimir observability stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Authentik (docker-compose.authentik.yml)
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_REDIS_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
AUTHENTIK_SECRET_KEY=REPLACE_WITH_SECURE_SECRET_KEY

# Temporal (docker-compose.temporal.yml)
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
